{
  "name": "growth-reseller-lab-completo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/unit/*.test.mjs tests/integration/*.test.mjs tests/e2e/*.test.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:api",
    "test:api": "node --test tests/api/*.test.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "typescript": "^5.8.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  }
}
