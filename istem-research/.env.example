# ISTEM RESEARCH · variables de entorno (copiar a .env.local)
# Use un proyecto Supabase PROPIO para ISTEM RESEARCH: la migración 001 revoca la ejecución
# de todas las funciones del esquema public, por lo que no debe compartirse con otra aplicación.
SUPABASE_URL=https://<proyecto>.supabase.co
SUPABASE_ANON_KEY=
# Solo servidor. En la fase 1 se usa únicamente en scripts de administración, nunca en peticiones de usuarios.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3010
