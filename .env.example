# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Obligatorio en producción: valor aleatorio de 32+ caracteres (p. ej. `openssl rand -hex 32`).
SESSION_SECRET=

# "true" crea las cuentas demo y habilita depósitos simulados. En producción es "false" salvo que se indique.
DEMO_MODE=true

# Administrador inicial fuera del modo demo (contraseña de 12+ caracteres).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secreto para firmar webhooks (HMAC-SHA256).
WEBHOOK_SIGNING_SECRET=
