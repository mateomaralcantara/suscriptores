# Application
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Supabase (server-side configuration)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ADMIN_EMAILS=admin@example.com

# SMM provider
SMM_PANEL_API_URL=https://smm-panel.net/api/v2
SMM_PANEL_API_KEY=YOUR_ROTATED_API_KEY
SMM_PANEL_NAME=SMM-Panel
SMM_MARKUP_PERCENT=30

# Additional providers (API v2 compatible). Slots 2 to 5. Their service IDs are shown as
# (slot-1) x 10,000,000 + provider ID, e.g. FlowLine service 907 in slot 2 -> 10000907.
SMM_PROVIDER_2_NAME=
SMM_PROVIDER_2_API_URL=
SMM_PROVIDER_2_API_KEY=
# Optional: own markup for this provider (defaults to SMM_MARKUP_PERCENT)
SMM_PROVIDER_2_MARKUP_PERCENT=
SMM_LIVE_ORDERS_ENABLED=false

# Stripe (wallet top-ups). Webhook endpoint: <APP_URL>/api/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NOWPayments (crypto top-ups). IPN URL: <APP_URL>/api/webhooks/nowpayments
# Dashboard: Store settings -> API keys (API key) and IPN secret key. Payouts: set your USDT wallet.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Bank transfers in local currency (manual approval in Admin > Recargas por transferencia).
# Up to 4 accounts: BANK_<n>_NAME, BANK_<n>_ACCOUNT_TYPE, BANK_<n>_ACCOUNT_NUMBER, BANK_<n>_HOLDER, BANK_<n>_DOCUMENT
BANK_TRANSFER_RATE=
BANK_TRANSFER_CURRENCY=DOP
BANK_1_NAME=Banco Popular
BANK_1_ACCOUNT_TYPE=Cuenta de ahorros
BANK_1_ACCOUNT_NUMBER=
BANK_1_HOLDER=
BANK_1_DOCUMENT=
BANK_2_NAME=Banreservas
BANK_2_ACCOUNT_TYPE=Cuenta de ahorros
BANK_2_ACCOUNT_NUMBER=
BANK_2_HOLDER=
BANK_2_DOCUMENT=

# Order sync job (/api/cron/sync-orders). At least 16 random characters.
CRON_SECRET=

# Optional integrations
RESEND_API_KEY=
REDIS_URL=
